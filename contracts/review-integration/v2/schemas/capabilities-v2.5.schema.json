{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-smith.dev/contracts/review-integration/v2/schemas/capabilities-v2.5.schema.json",
  "title": "Agent Smith review integration capabilities protocol 2.5",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "contract", "protocol", "package", "build", "executable", "operations", "gates",
    "projections", "schemas", "features", "compatibility"
  ],
  "properties": {
    "schema": {"const": "agent-smith.review-integration.capabilities/v2.5"},
    "contract": {"$ref": "capabilities-v2.3.schema.json#/properties/contract"},
    "protocol": {
      "type": "object", "additionalProperties": false, "required": ["major", "minor"],
      "properties": {"major": {"const": 2}, "minor": {"const": 5}}
    },
    "package": {"$ref": "capabilities-v2.3.schema.json#/properties/package"},
    "build": {"$ref": "capabilities-v2.3.schema.json#/properties/build"},
    "executable": {"$ref": "capabilities-v2.3.schema.json#/properties/executable"},
    "operations": {"$ref": "capabilities-v2.3.schema.json#/properties/operations"},
    "gates": {"$ref": "capabilities-v2.3.schema.json#/properties/gates"},
    "projections": {"$ref": "capabilities-v2.3.schema.json#/properties/projections"},
    "schemas": {"type": "array", "minItems": 22, "maxItems": 22, "uniqueItems": true, "items": {"enum": [
      "agent-smith.review-admitted-result/v2", "agent-smith.review-artifact-subject/v2",
      "agent-smith.review-authority-repair-assessment/v1", "agent-smith.review-authority-status/v1",
      "agent-smith.review-gate-request/v1", "agent-smith.review-integration.capabilities/v2.5",
      "agent-smith.review-integration.consent/v3", "agent-smith.review-integration.failure/v2",
      "agent-smith.review-integration.operation/v2", "agent-smith.review-integration.projection/v1",
      "agent-smith.review-integration.repair/v2", "agent-smith.review-integration.start/v4",
      "agent-smith.review-integration.status/v5", "agent-smith.review-integration.status/v6",
      "agent-smith.review-integration.status/v7",
          "agent-smith.review-intended-untracked-selection/v1",
      "agent-smith.review-receipt/v1", "agent-smith.review-result-artifact/v2",
      "agent-smith.review-targeted-validation-request/v1", "https://agent-smith.dev/schema/review/refuter/v1",
      "https://agent-smith.dev/schema/review/reviewer/v1", "https://agent-smith.dev/schema/review/validator/v1"
    ]}},
    "features": {"$ref": "capabilities-v2.3.schema.json#/properties/features"},
    "bootstrap": {"$ref": "capabilities-v2.3.schema.json#/properties/bootstrap"},
    "compatibility": {"$ref": "capabilities-v2.3.schema.json#/properties/compatibility"}
  }
}

